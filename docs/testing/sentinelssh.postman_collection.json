        {
          "name": "GET /api/analyses/{{analysisId}} → 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('code 200', () => pm.response.to.have.status(200));",
                  "const s = pm.response.json().suspects;",
                  "pm.test('3 gravités', () => pm.expect(s.map(x => x.severity)).to.include.members(['critique', 'elevee', 'moyenne']));",
                  "pm.test('commande seulement pour élevée et critique (D13)', () => s.forEach(x => pm.expect(x.block_command === null).to.eql(x.severity === 'moyenne')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/analyses/{{analysisId}}",
              "host": [
                "{{baseUrl}}"
