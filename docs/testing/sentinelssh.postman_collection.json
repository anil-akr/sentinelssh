                  "key": "file",
                  "type": "file",
                  "src": "docs/testing/gros.log"
                }
              ]
            }
          },
          "description": "Créer un fichier de plus de 5 Mo : head -c 6000000 /dev/zero > gros.log, puis le choisir dans Body."
        },
