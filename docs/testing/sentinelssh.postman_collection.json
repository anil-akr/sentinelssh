{
  "info": {
    "name": "SentinelSSH — API",
    "description": "Les 8 routes de l'API SentinelSSH. Lancer Flask (flask --app app run dans backend/), mettre le mot de passe administrateur dans la variable password, puis exécuter la collection dans l'ordre (Run collection). Les requêtes d'envoi de fichier demandent de choisir le fichier dans l'onglet Body.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Sans session",
      "item": [
        {
          "name": "GET /api/analyses sans session → 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('code 401', () => pm.response.to.have.status(401));",
                  "pm.test('message', () => pm.expect(pm.response.json().error).to.eql(\"Connexion requise\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/analyses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "analyses"
              ]
            }
          },
          "description": ""
        },
        {
          "name": "GET /api/auth/me sans session → 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('code 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            }
          },
          "description": ""
        }
      ]
    },
    {
      "name": "2. Connexion",
      "item": [
        {
          "name": "Login : champ manquant → 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('code 400', () => pm.response.to.have.status(400));",
                  "pm.test('message', () => pm.expect(pm.response.json().error).to.eql(\"Nom d'utilisateur et mot de passe obligatoires\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"username\": \"{{username}}\"}"
            }
          },
          "description": ""
        },
        {
          "name": "Login : mauvais mot de passe → 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('code 401', () => pm.response.to.have.status(401));",
                  "pm.test('message', () => pm.expect(pm.response.json().error).to.eql(\"Identifiants incorrects\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"username\": \"{{username}}\", \"password\": \"mauvais-mot-de-passe\"}"
            }
          },
          "description": ""
        },
        {
          "name": "Login : compte inconnu → 401 (même message)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('code 401', () => pm.response.to.have.status(401));",
                  "pm.test('message', () => pm.expect(pm.response.json().error).to.eql(\"Identifiants incorrects\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"username\": \"inconnu\", \"password\": \"mauvais-mot-de-passe\"}"
            }
          },
          "description": ""
        },
        {
          "name": "Login : bon mot de passe → 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('code 200', () => pm.response.to.have.status(200));",
                  "pm.test('cookie de session', () => pm.expect(pm.cookies.has('session')).to.be.true);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"username\": \"{{username}}\", \"password\": \"{{password}}\"}"
            }
          },
          "description": ""
        },
        {
          "name": "GET /api/auth/me → 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('code 200', () => pm.response.to.have.status(200));",
                  "pm.test('nom', () => pm.expect(pm.response.json().username).to.eql(pm.collectionVariables.get('username')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            }
          },
          "description": ""
        }
      ]
    },
    {
      "name": "3. Analyses",
      "item": [
        {
          "name": "POST /api/analyses : demo.log → 201",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('code 201', () => pm.response.to.have.status(201));",
                  "const d = pm.response.json();",
                  "pm.collectionVariables.set('analysisId', d.id);",
                  "pm.test('IP suspectes', () => pm.expect(d.suspect_count).to.be.above(0));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/analyses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "analyses"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "demo/demo.log"
                }
              ]
            }
          },
          "description": "Choisir le fichier demo/demo.log du dépôt dans l'onglet Body si Postman ne le trouve pas."
        },
        {
          "name": "POST /api/analyses : 2e envoi de demo.log → 201",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('code 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('secondId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/analyses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "analyses"
