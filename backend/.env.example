# Réglages propres à cette machine. Copier ce fichier en .env (jamais
# commité), puis remplacer les valeurs.

# --- Session ---------------------------------------------------------------
# Clé qui signe le cookie de session : sans elle, impossible de fabriquer
# un faux cookie. Générer une valeur :
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=a-remplacer-par-une-longue-valeur-aleatoire

# Durée de vie de la session, en minutes sans requête. Au-delà, il faut
# se reconnecter.
SESSION_LIFETIME_MINUTES=60

# --- CORS ------------------------------------------------------------------
# Origines autorisées à appeler l'API depuis un autre site, avec le cookie
# (séparées par des virgules). Toute autre origine est bloquée par le
# navigateur. Vide = aucune.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Chiffrement de la base ------------------------------------------------
# Chemin du fichier qui contient la clé de la base (64 caractères
# hexadécimaux), rangé HORS du dépôt. Le créer une fois :
#   mkdir -p ~/.config/sentinelssh
#   python3 -c "import secrets; print(secrets.token_hex(32))" > ~/.config/sentinelssh/db.key
#   chmod 600 ~/.config/sentinelssh/db.key
# Clé perdue = base illisible pour toujours : en garder une copie sûre.
DB_KEY_FILE=~/.config/sentinelssh/db.key
